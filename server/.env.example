# VASPTRACE API — environment configuration
# Copy to .env and fill in real values. Never commit .env.

PORT=5000
NODE_ENV=development

# MongoDB connection string (required)
MONGODB_URI=mongodb://127.0.0.1:27017/vasptrace

# Auth (required) — use a long random string, e.g. `openssl rand -hex 48`
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Frontend origin allowed by CORS (comma-separated list supported)
CLIENT_URL=http://localhost:5173

# --- Chain data (GraphSense) ------------------------------------------------
# Leave GRAPHSENSE_API_URL empty to use the deterministic synthetic provider.
# Hosted: https://api.ikna.io  ·  self-hosted: http://localhost:9000
# In production the URL must be https and the key is mandatory.
GRAPHSENSE_API_URL=
GRAPHSENSE_API_KEY=
GRAPHSENSE_TIMEOUT_MS=12000
