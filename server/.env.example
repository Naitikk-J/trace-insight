# VASPTRACE API — environment configuration
# Copy to .env and fill in real values. Never commit .env.

PORT=5000
NODE_ENV=development

# MongoDB connection string (required)
MONGODB_URI=mongodb://127.0.0.1:27017/vasptrace

# Auth (required) — use a long random string, e.g. `openssl rand -hex 48`
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Frontend origin allowed by CORS (comma-separated list supported)
CLIENT_URL=http://localhost:5173

# --- Chain data (GraphSense) ------------------------------------------------
# Leave GRAPHSENSE_API_URL empty to use the deterministic synthetic provider.
# Hosted: https://api.ikna.io  ·  self-hosted: http://localhost:9000
# In production the URL must be https and the key is mandatory.
GRAPHSENSE_API_URL=
GRAPHSENSE_API_KEY=
GRAPHSENSE_TIMEOUT_MS=12000

# --- Complaint intake (NCRP / SAHYOG / LEA) ---------------------------------
# Comma-separated API keys presented as `x-api-key` on POST /api/intake/complaints.
# Leave empty to disable the machine-to-machine intake surface.
# Generate with: openssl rand -hex 32
INTAKE_API_KEYS=

# --- AI SYSTEM 1: VASPTRACE's own risk model --------------------------------
# mock  = deterministic in-process baseline (explainable, no network)
# remote = call a trained model service; MODEL_API_URL is then required
ML_PROVIDER=mock
MODEL_API_URL=
MODEL_API_KEY=
MODEL_TIMEOUT_MS=8000
MODEL_VERSION=vasptrace-risk-v1

# --- AI SYSTEM 2: external LLM (investigator copilot) -----------------------
# none | openai | gemini | anthropic
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
LLM_TIMEOUT_MS=45000
LLM_MAX_TOKENS=2048
# FULL | REDACTED | DISABLED — how much case data may leave the platform
LLM_DATA_POLICY=REDACTED

# Synthetic-data demonstration mode; always labelled in the UI
DEMO_MODE=false
