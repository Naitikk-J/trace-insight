# VASPTRACE API — environment configuration
# Copy to .env and fill in real values. Never commit .env.

PORT=5000
NODE_ENV=development

# MongoDB connection string (required)
MONGODB_URI=mongodb://127.0.0.1:27017/vasptrace

# Auth (required) — use a long random string, e.g. `openssl rand -hex 48`
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Frontend origin allowed by CORS (comma-separated list supported)
CLIENT_URL=http://localhost:5173
